PORT=3000
FRONTEND_URL=http://localhost:3000
# Atlas or a replica set is required for wallet transactions.
MONGODB_URI=mongodb://127.0.0.1:27018/ecosync?replicaSet=ecosync
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable: encrypts permanent QR tokens at rest.
IDENTITY_ENCRYPTION_KEY=
NODE_ENV=development
# Production defaults to 0.0.0.0; development defaults to loopback.
# HOST=0.0.0.0
# Set to 1 behind Render's ingress; leave unset for direct local access.
# TRUST_PROXY_HOPS=1
# Optional real classifier; request/response contract is in README.
AI_MODEL_ENDPOINT=
AI_MODEL_KEY=
# Local EcoSort adapter; npm run classifier:setup connects empty AI endpoints.
AI_HEALTH_ENDPOINT=
CLASSIFIER_MODEL_PATH=best.pt
CLASSIFIER_PORT=8001
CLASSIFIER_DEVICE=cpu
# Loopback by default. Set 0.0.0.0 only for a protected service deployment.
# CLASSIFIER_HOST=0.0.0.0
# Optional Python executable; otherwise uses .local/classifier-venv.
CLASSIFIER_PYTHON=
# Controller credentials are generated per machine by an admin, stored hashed in MongoDB.
# No shared default machine credential is provided.
